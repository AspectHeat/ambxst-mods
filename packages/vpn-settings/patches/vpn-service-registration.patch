diff --git a/shell.qml b/shell.qml
index 888996d3..17be2d28 100644
--- a/shell.qml
+++ b/shell.qml
@@ -309,6 +309,13 @@ ShellRoot {
         onTriggered: {
             let _ = NightLightClient.active;
             _ = GameModeClient.toggled;
+            // VPN services belong in this deferred tier, not the immediate one: no VPN
+            // surface is on the critical startup path, and eager init would begin CLI
+            // polling before the user has opened anything. Registering them here
+            // satisfies modules/services/AGENTS.md, which lists unregistered services as
+            // an anti-pattern. Reading a property is what forces singleton construction.
+            _ = NordVpnService.available;
+            _ = VpnService.routeOwner;
         }
     }
 }
