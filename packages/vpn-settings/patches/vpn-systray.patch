+    // VPN provider tray items (VpnProvider.trayComponent), drawn after the system tray icons.
+    // NordVPN has none: its own norduserd already puts one in the tray.
+    function showsVpnTray(provider): bool {
+        return provider.trayComponent !== null && provider.available && provider.enabled
+            && provider.showInBar;
+    }
+    readonly property bool vpnTrayVisible: {
+        for (let i = 0; i < VpnProviders.providers.length; i++) {
+            if (root.showsVpnTray(VpnProviders.providers[i]))
